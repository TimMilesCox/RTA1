p $proc
qipto* $name
pulley $set,96 1*+?
 + pulley:q
halyard $set,48 1*+?
 + halyard:d
actor $set 07FF**(pulley/*72)++((pulley/*95)*/11)
acted $set  0FFFFFFFFFFFFFFF**(pulley/*12)+0C00000
 $if 01000000000000000**acted
acted $set acted/*1
actor $set actor+1
 $endif
 + actor*/36++acted/*24:d
 $end
? $do 2, qipto
 $end
